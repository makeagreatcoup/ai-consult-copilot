# 咨询AI副驾 - 环境变量配置
# 复制此文件为 .env 并填入实际值

# ==================== LLM 配置（二选一）====================

# ── 方案 A：智谱 GLM（macOS 推荐）──
# 申请：https://open.bigmodel.cn/
ZHIPUAI_API_KEY=
# 模型：glm-4-flash（免费/快速）/ glm-4-air（低价）/ glm-4（高质量）
GLM_MODEL=glm-4-flash

# ── 方案 B：Anthropic Claude（Windows 原版）──
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# CLAUDE_MODEL=claude-sonnet-4-20250514

# ==================== Whisper 配置 ====================

# 模型大小（tiny/base/small/medium）
# Intel Mac 推荐 base（速度/精度平衡）
WHISPER_MODEL=base

# 计算设备（cuda / cpu）
# macOS 强制 cpu；Windows 有 GPU 用 cuda
WHISPER_DEVICE=cpu

# 计算精度（float16 / int8）
WHISPER_COMPUTE_TYPE=int8

# ==================== 其他 ====================

# 收件箱监听开关（true/false）
INBOX_WATCH_ENABLED=true
